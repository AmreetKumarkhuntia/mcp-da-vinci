{
  "name": "mcp-da-vinci",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the DaVinci Resolve scripting API to an LLM",
  "license": "MIT",
  "author": "Amreet Khuntia",
  "scripts": {
    "cli": "python.exe cli.py",
    "inspector": "mcp-inspector python.exe server.py",
    "serve": "python.exe server.py",
    "serve:http": "cross-env RESOLVE_MCP_TRANSPORT=streamable-http python.exe server.py"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.16.2",
    "cross-env": "^7.0.3"
  }
}
